# =============================================================================
# 本地入口覆盖层（可选）
#
# 用法：
#   1) 根 .env 填写 Cloud Run MCP URL + 密钥
#   2) cp env/local.env.example env/local.env
#   3) 本文件只覆盖「入口模式」；不要再写 127.0.0.1 MCP
#
# 谁读取：
#   run_adk_*.sh / run_feishu_*.sh：先 .env，再本文件（后者覆盖同名键）
# =============================================================================

FEISHU_RUN_MODE=local
WIDGET_RUN_MODE=local

# 可选：发票图片/PDF识别（SAP 开关、worker 地址与令牌参见根 .env.example）
# INVOICE_RECOGNITION_MODEL=gemini-3.8-flash
# 本机 SAP 与云端对话桥接：python -m scripts.sap_local_bridge --tse-email name@example.com --sync-cloud-env
# 脚本会生成 loopback URL/令牌/用户绑定；根 .env 使用独立的公网 HTTPS 地址。
# SAP_WORKER_ALLOWED_USERS=tse:name@example.com

# 国内 Vertex 代理（按需）
# VERTEX_HTTP_PROXY=http://127.0.0.1:7890
