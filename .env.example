# =============================================================================
# SmartAgents 环境变量模板（统一前缀命名）
# 使用方法：cp .env.example .env，然后填入真实值
# =============================================================================

# --- Google Cloud（必填）---
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=000000000000
GCP_LOCATION=us-central1

# --- Vertex AI Reasoning Engine ID（部署后获取）---
BILIBILI_REST_AGENT_ENGINE_ID=your-bilibili-rest-engine-id
BILIBILI_MCP_AGENT_ENGINE_ID=your-bilibili-mcp-engine-id
ETSY_REST_AGENT_ENGINE_ID=your-etsy-rest-engine-id
ETSY_MCP_AGENT_ENGINE_ID=your-etsy-mcp-engine-id
SMART_AGENTS_ENGINE_ID=your-smart-agents-reasoning-engine-id

# --- MCP Agent Registry（仅 MCP 云端路径）---
MCP_SERVER_REGISTRY_ID=your-mcp-server-registry-id

# --- REST 端点（本地/云端联调）---
# 本地直连：
# BILIBILI_REST_SERVER_URL=http://127.0.0.1:8001
# ETSY_REST_SERVER_URL=http://127.0.0.1:8001
# 云端 Playground：改为 Cloudflare Quick Tunnel 的 https 域名
# BILIBILI_REST_SERVER_URL=https://<uuid>.trycloudflare.com
# ETSY_REST_SERVER_URL=https://<uuid>.trycloudflare.com
BILIBILI_REST_SERVER_URL=http://127.0.0.1:8001
ETSY_REST_SERVER_URL=http://127.0.0.1:8001

# --- MCP 端点（本地/云端联调）---
# 本地直连：
# BILIBILI_MCP_SERVER_URL=http://127.0.0.1:8002/mcp
# ETSY_MCP_SERVER_URL=http://127.0.0.1:8003/mcp
# 云端 Playground：
# BILIBILI_MCP_SERVER_URL=https://<bilibili-uuid>.trycloudflare.com/mcp
# ETSY_MCP_SERVER_URL=https://<etsy-uuid>.trycloudflare.com/mcp
BILIBILI_MCP_SERVER_URL=http://127.0.0.1:8002/mcp
ETSY_MCP_SERVER_URL=http://127.0.0.1:8003/mcp

# MCP Host 白名单（不含 https:// 和端口；也可从上方 URL 自动解析）
BILIBILI_TUNNEL_HOST=
ETSY_TUNNEL_HOST=

# --- smart_agents 覆盖端点（可选）---
SMART_AGENTS_BILIBILI_MCP_SERVER_URL=http://127.0.0.1:8002/mcp
SMART_AGENTS_ETSY_MCP_SERVER_URL=http://127.0.0.1:8003/mcp

# --- 小智知识库 RAG（Vertex RAG Engine）---
# RAG_ENABLED=true
# RAG_CORPUS_NAME=projects/<project>/locations/<loc>/ragCorpora/<id>
# RAG_LOCATION=asia-east1   # 须与 corpus 所在 region 一致；可省略（从 CORPUS_NAME 解析）
# RAG_PROJECT_ID=             # 可选，默认用 GCP_PROJECT_ID

# --- 可选：Widget 覆盖 Agent（不设则使用 SMART_AGENTS_ENGINE_ID）---
# WIDGET_RUN_MODE=local   # local: 本地 smart_agents runner（免部署）; cloud: Agent Engine
# AGENT_RESOURCE_NAME=projects/<project-number>/locations/us-central1/reasoningEngines/<engine-id>
# WIDGET_PORT=8000
# REST_NODE_PORT=8001

# --- 可选：国内访问 Vertex AI 时代理 ---
# VERTEX_HTTP_PROXY=http://127.0.0.1:7890

# --- Etsy Open API（etsy_agent 本地测试；申请步骤见 user_guide.md §0.5）---
ETSY_KEYSTRING=your-etsy-keystring
ETSY_SHARED_SECRET=your-etsy-shared-secret
# 或：ETSY_API_KEY=keystring:shared_secret

# --- 飞书机器人（integrations/feishu）---
# 飞书通道运行模式：local（本地 Runner）| cloud（云端 Agent Runtime）
FEISHU_RUN_MODE=local
#
# local 模式：
# - 启动 Bridge 前需先启动本地 BILIBILI/ETSY MCP（:8002 / :8003）
# - Bridge 进程内直接调用 smart_agents
#
# cloud 模式：
# - Bridge 调用云端 Agent Engine Runtime
# - 需满足以下二选一：
#   1) 显式配置 AGENT_RESOURCE_NAME
#   2) 配置 GCP_PROJECT_NUMBER + GCP_LOCATION + SMART_AGENTS_ENGINE_ID
# AGENT_RESOURCE_NAME=projects/000000000000/locations/us-central1/reasoningEngines/<SMART_AGENTS_ENGINE_ID>
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=your-app-secret
# 主人忠诚模式（建议开启）：仅主人可改策略；他人攻击/辱骂主人会被拦截
# FEISHU_OWNER_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxx
# FEISHU_OWNER_ALIASES=owner_display_name,nickname
# FEISHU_STRICT_LOYALTY_MODE=true
# FEISHU_APP_TOKEN=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
# FEISHU_BOT_OPEN_ID=ou_xxxxxxxx
# FEISHU_GROUP_REQUIRE_MENTION=true
# FEISHU_SEND_ACK=true
# FEISHU_SEND_PROGRESS=true
# FEISHU_PROGRESS_MIN_INTERVAL_SEC=1.5
# FEISHU_ACK_TEXT=小智已收到，正在为您处理，请稍候…
# FEISHU_SSL_VERIFY=false

# SmartAgents Session 事件压缩（可选，默认开启）
# SMART_AGENTS_DISABLE_EVENT_COMPACTION=true
# SMART_AGENTS_COMPACTION_TOKEN_THRESHOLD=80000
# SMART_AGENTS_COMPACTION_EVENT_RETENTION=20
# SMART_AGENTS_COMPACTION_INTERVAL=5
# SMART_AGENTS_COMPACTION_OVERLAP=2
