# =============================================================================
# SmartAgents 环境变量模板
# 使用方法：cp .env.example .env  然后填入你的真实值
# .env 已加入 .gitignore，请勿提交到 Git
# =============================================================================

# --- Google Cloud（必填，云端 Agent / Widget / Skill Registry）---
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=000000000000
GCP_LOCATION=us-central1

# --- Vertex AI Reasoning Engine ID（部署后从控制台获取）---
REST_AGENT_ENGINE_ID=your-rest-reasoning-engine-id
MCP_AGENT_ENGINE_ID=your-mcp-reasoning-engine-id

# --- MCP Agent Registry（仅 MCP 云端路径；GCP Console → Agent Registry）---
MCP_SERVER_REGISTRY_ID=your-mcp-server-registry-id

# --- ngrok 穿透（云端 Agent 访问本机 RPA 时必填；本地纯 adk run 可用 127.0.0.1）---
# REST Agent → local_node/server.py :8001
NGROK_URL=https://your-subdomain.ngrok-free.dev
# MCP Agent → mcp_server/bilibili_mcp.py :8002
MCP_SERVER_URL=https://your-subdomain.ngrok-free.dev/mcp
# MCP Host 白名单（不含 https:// 和端口）
NGROK_HOST=your-subdomain.ngrok-free.dev

# --- 可选：国内访问 Vertex AI 时代理（Clash 等）---
# VERTEX_HTTP_PROXY=http://127.0.0.1:7890

# --- 可选：Widget 服务 ---
# WIDGET_PORT=8000
# REST_NODE_PORT=8001
