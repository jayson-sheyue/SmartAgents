# =============================================================================
# SmartAgents 环境变量模板
# 使用方法：cp .env.example .env，然后填入真实值
# 分场景 profile 见 env/*.env.example（推荐本地开发用 env/ 而非只改本文件）
# =============================================================================

# --- Google Cloud（必填）---
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=000000000000
GCP_LOCATION=us-central1

# --- Vertex AI Reasoning Engine ID（adk deploy 后填入）---
BILIBILI_MCP_AGENT_ENGINE_ID=your-bilibili-engine-id
ETSY_MCP_AGENT_ENGINE_ID=your-etsy-engine-id
SMART_AGENTS_ENGINE_ID=your-smart-agents-engine-id
# 并行第二 Engine：A2A 包装（deploy_smart_agents_a2a.sh；勿覆盖上一行 xiaozhi）
# SMART_AGENTS_A2A_ENGINE_ID=
# SMART_AGENTS_A2A_STAGING_BUCKET=gs://your-project-adk-staging

# --- Cloud Run MCP（必填；先 deploy_*_mcp_cloudrun.sh）---
BILIBILI_MCP_SERVER_URL=https://bilibili-mcp-xxxxx.run.app/mcp
ETSY_MCP_SERVER_URL=https://etsy-mcp-xxxxx.run.app/mcp
FEISHU_MCP_SERVER_URL=https://feishu-mcp-xxxxx.run.app/mcp
# 可选覆盖
# SMART_AGENTS_BILIBILI_MCP_SERVER_URL=
# SMART_AGENTS_ETSY_MCP_SERVER_URL=
# SMART_AGENTS_FEISHU_MCP_SERVER_URL=

# Excel / 产物 GCS（两 MCP 共用或分桶）
MCP_ARTIFACT_GCS_BUCKET=your-mcp-artifacts-bucket
MCP_ARTIFACT_GCS_PREFIX=mcp-artifacts/
# 生图也可复用 ETSY_IMAGE_GCS_BUCKET

# --- 小智知识库 RAG（Vertex RAG Engine，可选）---
# RAG_ENABLED=true
# RAG_CORPUS_NAME=projects/your-gcp-project/locations/asia-east1/ragCorpora/1234567890123456789
# RAG_LOCATION=asia-east1
# RAG_PROJECT_ID=
# （TSE 知识投递入库后 import 到同一 corpus；小智用 search_tse_knowledge / rag_search）

# --- 小智 Code Execution（Vertex Agent Engine Sandbox，可选）---
# 启用后小智可在 GCP 隔离沙箱执行 Python（pandas/openpyxl/matplotlib）；仅 us-central1
# CODE_EXECUTION_ENABLED=true
# CODE_EXEC_LOCATION=us-central1
# 默认复用 SMART_AGENTS_ENGINE_ID；也可显式指定完整 resource name：
# CODE_EXEC_AGENT_ENGINE_RESOURCE_NAME=projects/<project>/locations/us-central1/reasoningEngines/<id>
# 复用已有 sandbox（可选）：
# CODE_EXEC_SANDBOX_RESOURCE_NAME=projects/<project>/locations/us-central1/reasoningEngines/<id>/sandboxEnvironments/<id>
# CODE_EXECUTION_STATEFUL=true
# CODE_EXECUTION_OPTIMIZE_DATA_FILE=true
# CODE_EXECUTION_TIMEOUT_SECONDS=120
# CODE_EXECUTION_ERROR_RETRY=2

# --- 小智 GCP 数据 MCP（Knowledge Catalog + Firestore Remote MCP，可选）---
# 一键开启两者：
# GCP_DATA_MCP_ENABLED=true
# 或分别开启：
# KC_MCP_ENABLED=true
# FIRESTORE_MCP_ENABLED=true
# KC_MCP_URL=https://dataplex.googleapis.com/mcp
# FIRESTORE_MCP_URL=https://firestore.googleapis.com/mcp
# TSE_FIRESTORE_PROJECT_ID=your-gcp-project
# TSE_FIRESTORE_DATABASE=tse-jayson-database
# TSE_CUSTOMER_ITEM_TYPE=customer
# TSE_CUSTOMER_STRICT_ITEM_TYPE=false  # true 时仅统计 item_type==customer（会漏掉空 item_type 历史数据）
# TSE 外部 API（开放语义 /chat、全局大盘 /global_report）
# 根地址由环境配置；API Key 由用户在对话中私聊提供并写入 Session（set_tse_session_api_key）
# TSE_API_BASE_URL=https://your-tse-app.run.app
# TSE_API_KEY=   # 可选运维回落；生产优先会话 Key，不必注入共享临时 Key
# 需 ADC：gcloud auth application-default login
# IAM：roles/mcp.toolUser、KC dataplex.catalogViewer、Firestore roles/datastore.viewer（只读）

# --- Web Widget（可选）---
# WIDGET_RUN_MODE=local
# WIDGET_PORT=8000
# AGENT_RESOURCE_NAME=projects/<number>/locations/us-central1/reasoningEngines/<id>

# --- 可选：国内访问 Vertex AI 时代理 ---
# VERTEX_HTTP_PROXY=http://127.0.0.1:7890

# --- Etsy Open API（etsy_mcp 后端读取；申请步骤见 user_guide.md §0.5）---
ETSY_KEYSTRING=your-etsy-keystring
ETSY_SHARED_SECRET=your-etsy-shared-secret

# --- Etsy 上架素材生图（Vertex；凭证走 gcloud ADC）---
ETSY_IMAGE_MODEL=gemini-3.1-flash-image
ETSY_IMAGE_LOCATION=global
# ETSY_IMAGE_GCS_BUCKET=your-gcs-bucket-name
ETSY_IMAGE_GCS_PREFIX=etsy/
ETSY_IMAGE_ASPECT_RATIO=1:1

# --- Etsy 生图预设（可选）---
# ETSY_PRESET_DIR=~/Documents/EtsyData/presets
# ETSY_PROMPT_MODEL=gemini-2.5-flash
# ETSY_PROMPT_LOCATION=us-central1

# --- 飞书机器人（integrations/feishu）---
FEISHU_RUN_MODE=local
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=your-app-secret
# FEISHU_OWNER_OPEN_ID=
# FEISHU_OWNER_ALIASES=
# FEISHU_STRICT_LOYALTY_MODE=true
# FEISHU_SSL_VERIFY=false
# 本地 Runner 会话防爆闸（避免上下文无限膨胀导致 400 token overflow）
# FEISHU_LOCAL_SESSION_GUARD_ENABLED=true
# FEISHU_LOCAL_SESSION_MAX_EVENTS=240
# FEISHU_LOCAL_SESSION_MAX_CHARS=600000

# --- SmartAgents Session 事件压缩（可选）---
# SMART_AGENTS_DISABLE_EVENT_COMPACTION=true
# SMART_AGENTS_COMPACTION_TOKEN_THRESHOLD=80000
# SMART_AGENTS_COMPACTION_EVENT_RETENTION=20
# SMART_AGENTS_COMPACTION_INTERVAL=5
# SMART_AGENTS_COMPACTION_OVERLAP=2
# SAP Computer Use（可选；不开启则原有功能不受影响）
SAP_COMPUTER_USE_ENABLED=false
SAP_BROWSER_EXECUTION_MODE=local
# Cloud Run worker requires IAM in addition to the application token
# SAP_COMPUTER_USE_IAM_AUTH=true
# SAP_CLOUD_SERVICE=sap-browser-demo
# SAP_CLOUD_SERVICE_ACCOUNT=sap-browser-worker@your-project.iam.gserviceaccount.com
# SAP_AUTH_STATE_BUCKET=your-private-sap-auth-state-bucket
# SAP_CLOUD_INVOKER_ACCOUNTS=tse-runtime@your-project.iam.gserviceaccount.com,agent-runtime@your-project.iam.gserviceaccount.com
# SAP_DEPLOY_CHECK_USER=tse:your-tse-email@example.com
# SAP_LOGIN_ALLOWED_ORIGINS=https://your-exact-sap-identity-provider.example.com
# SAP_LOGIN_START_URL=https://your-approved-trial-or-sso-portal.example.com/login
# SAP_CLOUD_MAX_SESSIONS=4
SAP_COMPUTER_USE_WORKER_URL=http://127.0.0.1:8010
# 使用 python -c 'import secrets; print(secrets.token_urlsafe(32))' 生成；Agent 与 worker 必须一致
SAP_COMPUTER_USE_TOKEN=
SAP_BROWSER_URL=https://your-tenant.s4hana.cloud.sap/ui?sap-language=en#Shell-home
SAP_BROWSER_PROFILE_DIR=.sap_browser_profiles
SAP_COMPUTER_USE_MODEL=gemini-3.8-flash
SAP_COMPUTER_USE_GOLDEN_PATH=true
SAP_COMPUTER_USE_DEMO_MODE=computer-use
# 发票/PDF原生识别：启用 SAP 工具后挂到小智，使用现有 Vertex 凭据
INVOICE_RECOGNITION_MODEL=gemini-3.8-flash
# 本机 worker 用户绑定（由 sap_local_bridge 启动脚本填写到 env/local.env，不传到前端）
# SAP_WORKER_ALLOWED_USERS=tse:name@example.com
# SAP_COMPUTER_USE_PORT=8011
