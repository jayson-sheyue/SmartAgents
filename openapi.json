{
    "openapi": "3.1.0",
    "info": {
      "title": "B站 RPA 本地节点 API",
      "description": "供云端 Agent 调用的本地 RPA 接口",
      "version": "1.0.0"
    },
    "paths": {
      "/api/get_up_list": {
        "get": {
          "summary": "读取本地 Excel 获取 UP 主名单",
          "operationId": "api_get_list_api_get_up_list_get",
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
  
                  }
                }
              }
            }
          }
        }
      },
      "/api/fetch_fans_data": {
        "post": {
          "summary": "启动本地浏览器抓取粉丝数",
          "operationId": "api_fetch_fans_api_fetch_fans_data_post",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpNameRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
  
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/write_excel": {
        "post": {
          "summary": "将粉丝数回写到本地 Excel",
          "operationId": "api_write_excel_api_write_excel_post",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteDataRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
  
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "HTTPValidationError": {
          "properties": {
            "detail": {
              "items": {
                "$ref": "#/components/schemas/ValidationError"
              },
              "type": "array",
              "title": "Detail"
            }
          },
          "type": "object",
          "title": "HTTPValidationError"
        },
        "UpNameRequest": {
          "properties": {
            "up_name": {
              "type": "string",
              "title": "Up Name"
            }
          },
          "type": "object",
          "required": [
            "up_name"
          ],
          "title": "UpNameRequest"
        },
        "ValidationError": {
          "properties": {
            "loc": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array",
              "title": "Location"
            },
            "msg": {
              "type": "string",
              "title": "Message"
            },
            "type": {
              "type": "string",
              "title": "Error Type"
            },
            "input": {
              "title": "Input"
            },
            "ctx": {
              "type": "object",
              "title": "Context"
            }
          },
          "type": "object",
          "required": [
            "loc",
            "msg",
            "type"
          ],
          "title": "ValidationError"
        },
        "WriteDataRequest": {
          "properties": {
            "up_name": {
              "type": "string",
              "title": "Up Name"
            },
            "fans_count": {
              "type": "string",
              "title": "Fans Count"
            }
          },
          "type": "object",
          "required": [
            "up_name",
            "fans_count"
          ],
          "title": "WriteDataRequest"
        }
      }
    }
  }