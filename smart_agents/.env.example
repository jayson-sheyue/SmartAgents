# Agent Engine 运行时 env（由 deploy_smart_agents.sh 生成；本文件仅作模板）
BILIBILI_MCP_SERVER_URL=https://bilibili-mcp-xxxxx.run.app/mcp
ETSY_MCP_SERVER_URL=https://etsy-mcp-xxxxx.run.app/mcp
FEISHU_MCP_SERVER_URL=https://feishu-mcp-xxxxx.run.app/mcp
MCP_ARTIFACT_GCS_BUCKET=
GCP_PROJECT_ID=
RAG_ENABLED=false
CODE_EXECUTION_ENABLED=false
SMART_AGENTS_ENGINE_ID=
# Optional SAP browser worker (browser runs separately; never put token in frontend)
SAP_COMPUTER_USE_ENABLED=false
SAP_COMPUTER_USE_WORKER_URL=
SAP_COMPUTER_USE_TOKEN=
INVOICE_RECOGNITION_MODEL=gemini-3.8-flash
